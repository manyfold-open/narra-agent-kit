{
  "name": "@manyfold/narra-agent-kit",
  "version": "0.1.0",
  "description": "Decentralized, Manyfold-native Cloudflare Worker + Durable Objects Gateway SDK for Narra Messenger agents.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./adapters/manyfold-a2a": {
      "types": "./dist/adapters/manyfold-a2a.d.ts",
      "default": "./dist/adapters/manyfold-a2a.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@cloudflare/workers-types": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
